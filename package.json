{
  "name": "rast-obsidian",
  "version": "0.2.0",
  "private": true,
  "description": "Kurdish proofreading with Rast in Obsidian.",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run test && npm run build"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "obsidian": "1.8.7",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "obsidian": {
      "moment": "^2.31.0"
    }
  }
}
